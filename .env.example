# Canvas personal access token. Never commit a real token.
CANVAS_TOKEN=canvas_access_token_here

# Main SJTU Canvas site. You can switch this to https://jicanvas.com if needed.
CANVAS_BASE_URL=https://oc.sjtu.edu.cn

# Default output directory for downloaded files and indexes.
CANVAS_DATA_DIR=data

# Optional: advanced debugging only. Normally the CLI derives this through
# Canvas sessionless LTI launch and you should leave it empty.
# New video-platform JWT; not the legacy token.
SJTU_VIDEO_TOKEN=
# Teaching-class ID from launch-context, not the Canvas course ID.
SJTU_VIDEO_COURSE_ID=
